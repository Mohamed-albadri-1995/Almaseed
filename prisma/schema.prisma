// أرشيف المسيد — Prisma schema
// SQLite for local development. To deploy on PostgreSQL, change the
// provider below to "postgresql" and update DATABASE_URL.
//
// NOTE: SQLite does not support Prisma enums, so enum-like fields are stored
// as String and the allowed values are enforced in application code via the
// constants in src/lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & roles
// ---------------------------------------------------------------------------
// role values (see src/lib/constants.ts -> ROLES):
//  CONTRIBUTOR     المساهم       submit material, track submissions
//  REVIEWER        مراجع         review & publish material
//  EDITOR          محرر          edit materials & categories
//  CONTENT_MANAGER مدير محتوى    manage all content & contributors
//  ADMIN           مدير النظام   manage users, admins, settings

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         String   @default("CONTRIBUTOR")
  city         String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submissions   Material[]     @relation("submittedBy")
  reviewed      Material[]     @relation("reviewedBy")
  reviewNotes   ReviewNote[]
  favorites     Favorite[]
  notifications Notification[]
  activityLogs  ActivityLog[]
  ratings       Rating[]
  comments      Comment[]
}

// ---------------------------------------------------------------------------
// Categories
// ---------------------------------------------------------------------------

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique // madeeh, lectures, seminars, sermons, occasions
  name        String // المدائح
  description String? // أصوات المادحين وذاكرة الإنشاد
  icon        String? // icon key
  color       String? // tailwind accent hint
  order       Int        @default(0)
  materials   Material[]
}

// ---------------------------------------------------------------------------
// Materials (the archived items)
// ---------------------------------------------------------------------------
// status values (MATERIAL_STATUS): DRAFT, PENDING, PUBLISHED, NEEDS_EDIT, REJECTED, HIDDEN
// fileKind values (FILE_KINDS): AUDIO, VIDEO, DOCUMENT, IMAGE

model Material {
  id       String  @id @default(cuid())
  title    String
  subtitle String? // عنوان فرعي (لكل الأقسام)
  status   String  @default("PENDING")

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  description String?
  lyrics      String? // كلمات المدحة
  summary     String? // ملخص المحاضرة
  bodyText    String? // نص المقال المكتوب (قسم المقروءات)

  // People — semantics vary by category (madeeh / speaker / narrator / host)
  performer    String? // المادح
  narrator     String? // الراوي
  speaker      String? // المحاضر / المتحدث
  host         String? // مدير الندوة / مقدم البرنامج
  participants String? // أسماء المشاركين (comma separated)

  // Context
  occasion   String? // المناسبة
  topic      String? // الموضوع
  place      String? // المكان / المسيد / الجهة
  city       String? // المدينة أو المنطقة
  organizer  String? // الجهة المنظمة
  language   String?   @default("العربية")
  recordDate DateTime? // تاريخ التسجيل
  keywords   String? // الكلمات المفتاحية (comma separated)
  source     String? // المصدر / اسم المساهم النصي

  // Normalized concatenation of searchable text (diacritics stripped, letters
  // unified) — kept in sync on create/edit for fast, forgiving search.
  searchText String?

  // Duplicate merge: when set, this material was merged into another.
  mergedIntoId String?
  mergedInto   Material?  @relation("merge", fields: [mergedIntoId], references: [id])
  mergedFrom   Material[] @relation("merge")

  // File
  fileUrl     String?
  fileKind    String?  @default("AUDIO")
  fileType    String? // MP3, MP4, PDF ...
  fileSize    Int? // bytes
  durationSec Int? // مدة التسجيل بالثواني
  coverImage  String?

  // Metrics
  downloads Int @default(0)
  plays     Int @default(0)

  submittedById String?
  submittedBy   User?   @relation("submittedBy", fields: [submittedById], references: [id])
  reviewedById  String?
  reviewedBy    User?   @relation("reviewedBy", fields: [reviewedById], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  reviewNotes ReviewNote[]
  favorites   Favorite[]
  reports     ContentReport[]
  versions    MaterialVersion[]
  ratings     Rating[]
  comments    Comment[]

  @@index([status])
  @@index([categoryId])
}

// A 1–5 star rating, one per user per material.
model Rating {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  value      Int // 1..5
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, materialId])
  @@index([materialId])
}

// A public comment on a material. Visible unless hidden by a moderator.
model Comment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  body       String
  hidden     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([materialId])
}

// Snapshot of a material's data before an edit — the edit history / audit trail.
model MaterialVersion {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  editorId   String?
  editorName String?
  reason     String? // e.g. "edit", "merge", "resubmit"
  snapshot   String // JSON of the material fields at that time
  createdAt  DateTime @default(now())

  @@index([materialId])
}

// ---------------------------------------------------------------------------
// Review workflow
// ---------------------------------------------------------------------------
// action values (REVIEW_ACTIONS): APPROVE, REQUEST_EDIT, REJECT, DRAFT, RESUBMIT

model ReviewNote {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  reviewerId String?
  reviewer   User?    @relation(fields: [reviewerId], references: [id])
  action     String
  reason     String? // بيانات ناقصة / جودة ضعيفة / تكرار / مخالفة / حقوق
  note       String?
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Favorites, notifications, reports, activity log
// ---------------------------------------------------------------------------

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, materialId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model ContentReport {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  reason     String
  contact    String?
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// Per-day page-view counter for the system-admin statistics.
model DailyView {
  date  String @id // YYYY-MM-DD
  count Int    @default(0)
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  meta      String? // json string
  createdAt DateTime @default(now())

  @@index([createdAt])
}

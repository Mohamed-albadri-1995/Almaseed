// أرشيف المسيد — Prisma schema
// SQLite for local development. To deploy on PostgreSQL, change the
// provider below to "postgresql" and update DATABASE_URL.
//
// NOTE: SQLite does not support Prisma enums, so enum-like fields are stored
// as String and the allowed values are enforced in application code via the
// constants in src/lib/constants.ts.

generator client {
  provider = "prisma-client-js"
  // Global `omit` (src/lib/prisma.ts): heavy transcript columns stay out of every
  // query unless one asks for them. GA in Prisma 6; preview in 5.x.
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & roles
// ---------------------------------------------------------------------------
// role values (see src/lib/constants.ts -> ROLES):
//  CONTRIBUTOR     المساهم       submit material, track submissions
//  REVIEWER        مراجع         review & publish material
//  EDITOR          محرر          edit materials & categories
//  CONTENT_MANAGER مدير محتوى    manage all content & contributors
//  ADMIN           مدير النظام   manage users, admins, settings

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         String   @default("CONTRIBUTOR")
  city         String?
  active       Boolean  @default(true)
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  // Bumped on password reset / «sign out everywhere»: every session cookie and
  // app token carries the version it was issued with, and older ones are refused.
  sessionVersion      Int      @default(0)
  // «الدخول عبر Google فقط»: password sign-in is refused (and no code is ever
  // emailed), so a leaked/stored password is useless. Cleared by a password reset.
  googleOnly          Boolean  @default(false)
  assignedCategories String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  submissions   Material[]     @relation("submittedBy")
  reviewed      Material[]     @relation("reviewedBy")
  reviewNotes   ReviewNote[]
  favorites     Favorite[]
  notifications Notification[]
  activityLogs  ActivityLog[]
  ratings       Rating[]
  comments      Comment[]
  pushTokens    PushToken[]
}

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  icon        String?
  color       String?
  order       Int        @default(0)
  materials   Material[]
}

model Material {
  id       String  @id @default(cuid())
  title    String
  subtitle String?
  status   String  @default("PENDING")

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  description String?
  lyrics      String?
  summary     String?
  bodyText    String?

  performer    String?
  narrator     String?
  speaker      String?
  host         String?
  participants String?

  occasion   String?
  topic      String?
  place      String?
  city       String?
  organizer  String?
  language   String?   @default("العربية")
  recordDate DateTime?
  keywords   String?
  source     String?
  author     String?
  docType    String?

  searchText String?

  mergedIntoId String?
  mergedInto   Material?  @relation("merge", fields: [mergedIntoId], references: [id])
  mergedFrom   Material[] @relation("merge")

  fileUrl     String?
  // No default: a written article legitimately has no fileKind. Defaulting to
  // AUDIO mislabeled articles as صوت. Kind is set explicitly when a file exists.
  fileKind    String?
  fileType    String?
  fileSize    Int?
  durationSec Int?
  coverImage  String?
  // Set when the file/cover has had the السجادة watermark applied, so the
  // one-time backfill script never stamps the same material twice.
  watermarkedAt DateTime?
  // Last watermark error (null = success). Surfaced in /api/watermark-status
  // so a silent failure is visible instead of looking «finished».
  watermarkError String?
  // The pristine, un-watermarked source — captured once, before the first stamp.
  // The worker ALWAYS stamps from here, so re-running (requeue) never doubles the
  // stamp, and the original can be restored. fileUrl/coverImage serve the stamped
  // copy; these keep the source (also lets orphaned stamped copies be cleaned up).
  originalFileUrl    String?
  originalCoverImage String?

  // Automatic speech-to-text of the recording (lectures, sermons, rare archive).
  // transcriptSearch is its normalized form, written ONLY by the transcription
  // job, so ordinary edits (which rebuild searchText from form fields) never
  // drop it from search. transcribedAt = claimed/finished; transcriptError = last failure.
  transcript       String?
  transcriptSearch String?
  transcribedAt    DateTime?
  transcriptError  String?

  downloads Int @default(0)
  plays     Int @default(0)

  submittedById String?
  submittedBy   User?   @relation("submittedBy", fields: [submittedById], references: [id])
  reviewedById  String?
  reviewedBy    User?   @relation("reviewedBy", fields: [reviewedById], references: [id])
  // The reviewer who FIRST approved (published) this material. Set once and never
  // overwritten (unlike reviewedById, which tracks the latest review action). Used
  // by the collective-deletion flow: this reviewer already vouched for the material
  // so their approval is not required to delete it.
  firstApprovedById String?

  // Two-reviewer rejection hold: a first rejection sets status HELD, records the
  // rejecting reviewer here and the time in heldAt. A SECOND, different reviewer's
  // rejection finalizes REJECTED; if none arrives within 7 days of heldAt the
  // material is auto-published.
  firstRejectedById String?
  heldAt            DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  reviewNotes ReviewNote[]
  favorites   Favorite[]
  reports     ContentReport[]
  versions    MaterialVersion[]
  ratings     Rating[]
  comments    Comment[]
  deletionRequest DeletionRequest?

  @@index([status])
  @@index([categoryId])
}

// A pending request to permanently delete a published material. A reviewer can
// open one; it only executes once every OTHER reviewer of the category approves
// (the original approver and the requester are excluded). Any single rejection
// cancels it. Only PENDING requests are stored — resolving (delete/reject/cancel)
// removes the row (a material delete cascades it away).
model DeletionRequest {
  id            String         @id @default(cuid())
  materialId    String         @unique
  material      Material       @relation(fields: [materialId], references: [id], onDelete: Cascade)
  requestedById String
  reason        String?
  status        String         @default("PENDING")
  createdAt     DateTime       @default(now())
  resolvedAt    DateTime?
  votes         DeletionVote[]
}

model DeletionVote {
  id        String          @id @default(cuid())
  requestId String
  request   DeletionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  voterId   String
  vote      String
  createdAt DateTime        @default(now())

  @@unique([requestId, voterId])
}

model Rating {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  value      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([userId, materialId])
  @@index([materialId])
}

model Comment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  body       String
  hidden     Boolean  @default(false)
  createdAt  DateTime @default(now())
  @@index([materialId])
}

model MaterialVersion {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  editorId   String?
  editorName String?
  reason     String?
  snapshot   String
  createdAt  DateTime @default(now())
  @@index([materialId])
}

model ReviewNote {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  reviewerId String?
  reviewer   User?    @relation(fields: [reviewerId], references: [id])
  action     String
  reason     String?
  note       String?
  createdAt  DateTime @default(now())
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  @@unique([userId, materialId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([userId, read])
}

// Expo push tokens for the mobile app. A device may register anonymously
// (userId null) — every registered device receives «new content published»
// notifications. userId/role are filled in when a signed-in staff member
// registers, so targeted pushes are possible later.
model PushToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  role      String?
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}

model ContentReport {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  reason     String
  contact    String?
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model DailyView {
  date  String @id
  count Int    @default(0)
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  meta      String?
  createdAt DateTime @default(now())
  @@index([createdAt])
}

// Two-step sign-in for staff above reviewer: a short-lived 6-digit code sent by
// email after a correct password. Only the code's hash is stored.
model LoginChallenge {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

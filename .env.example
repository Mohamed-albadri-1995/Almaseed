# Copy to .env and fill in.
# SQLite for local/dev. For production use PostgreSQL and change the
# provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies (use a long random string).
AUTH_SECRET="change-me-to-a-long-random-string"

# Password-reset emails (Resend). RESEND_API_KEY is required to send the reset
# link. EMAIL_FROM must be a sender on a domain VERIFIED in Resend. Root domains
# often can't be verified, so use a mail subdomain, e.g. verify
# "mail.almaseeed.com" in Resend and set the sender to no-reply@mail.almaseeed.com.
# If EMAIL_FROM is unset, Resend's shared test sender is used (delivers only to
# the account owner until a domain is verified).
# APP_URL is the PUBLIC SITE origin used to build the reset link (the site
# domain, not the mail subdomain).
# RESEND_API_KEY=""
# EMAIL_FROM="أرشيف المسيد <no-reply@mail.almaseeed.com>"
# APP_URL="https://almaseeed.com"

# Where uploaded files are stored. Leave unset locally (defaults to
# public/uploads). On a container host, point this at a persistent volume,
# e.g. UPLOADS_DIR=/data/uploads
# UPLOADS_DIR="/data/uploads"

# Optional: S3 / Cloudflare R2 cloud storage. When ALL of these are set,
# uploads go to the bucket instead of the local volume. Leave unset to use
# local storage.
# STORAGE_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# STORAGE_REGION="auto"
# STORAGE_BUCKET="almaseed"
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""
# STORAGE_PUBLIC_URL="https://<your-public-bucket-domain>"

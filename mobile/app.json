{
  "expo": {
    "name": "الطريقة السمّانية",
    "slug": "almaseed",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#1f3d33",
    "splash": {
      "backgroundColor": "#1f3d33",
      "resizeMode": "contain"
    },
    "plugins": [
      ["expo-splash-screen", { "backgroundColor": "#1f3d33", "resizeMode": "contain" }]
    ],
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.almaseed.archive",
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "app.almaseed.archive",
      "permissions": ["FOREGROUND_SERVICE", "WAKE_LOCK"]
    }
  }
}
